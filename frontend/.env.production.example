# ─── RevFlow AI — Frontend Production Environment Variables ──────────────────
# Add these in the Vercel dashboard under Project → Settings → Environment Variables.

# ── Backend API URL (your Railway deployment URL) ─────────────────────────────
# Example: https://rev-flow-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=https://YOUR_RAILWAY_BACKEND_URL/api/v1

# ── WebSocket URL (same domain, ws:// → wss://) ───────────────────────────────
# Example: wss://rev-flow-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_WS_URL=wss://YOUR_RAILWAY_BACKEND_URL/api/v1
