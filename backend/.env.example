# Project metadata
PROJECT_NAME="RevFlow AI"
ENVIRONMENT=development
LOG_LEVEL=debug

# Databases URLs
# If running via docker-compose: postgres://postgres:postgres@postgres:5432/revflow
# If running locally: postgresql+asyncpg://postgres:postgres@localhost:5432/revflow
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revflow
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
