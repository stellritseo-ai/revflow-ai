# ─── RevFlow AI — Backend Production Environment Variables ───────────────────
# Copy this file to .env and fill in real values for production deployment.
# NEVER commit .env to git — it is in .gitignore.

# ── Core ──────────────────────────────────────────────────────────────────────
PROJECT_NAME="RevFlow AI"
ENVIRONMENT=production
LOG_LEVEL=info

# ── Database (use Supabase or Neon for managed PostgreSQL) ────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Supabase:  postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Neon:      postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/revflow

# ── Redis (use Upstash for managed Redis) ─────────────────────────────────────
# Format: redis://default:<password>@<host>:<port>
# Upstash:   rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=redis://default:password@host:6379

# ── CORS (add your Vercel frontend URL) ──────────────────────────────────────
# JSON array of allowed origins. Add your Vercel deployment URL here.
CORS_ORIGINS=["https://rev-flow.vercel.app","https://your-custom-domain.com"]

# ── Workers ───────────────────────────────────────────────────────────────────
WORKERS=2
